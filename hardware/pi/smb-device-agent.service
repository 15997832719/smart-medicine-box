[Unit]
Description=Smart Medicine Box Device Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
Group=orangepi
SupplementaryGroups=video
WorkingDirectory=/home/orangepi
ExecStart=/usr/bin/python3 /home/orangepi/device_agent_client.py --config /home/orangepi/device-agent.json
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target